@Library('my-shared-library') _

pipeline {

    agent any
   stages{
    stage('Test Kubernetes') {
    steps {
        withCredentials([
            file(
                credentialsId: 'kubeconfig-kind',
                variable: 'KUBECONFIG'
            )
        ]) {
            sh '''
                echo "Testing Kubernetes connection..."

                kubectl --kubeconfig="$KUBECONFIG" \
                    config current-context

                kubectl --kubeconfig="$KUBECONFIG" \
                    get nodes
            '''
        }
    }
}
}
}
